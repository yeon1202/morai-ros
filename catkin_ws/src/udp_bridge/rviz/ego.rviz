    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /object_markers
      Name: Objects
      Namespaces:
        objects: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lattice_candidates
      Name: LatticeCandidates
      Namespaces:
        lattice: true
      Queue Size: 100
      Value: true
