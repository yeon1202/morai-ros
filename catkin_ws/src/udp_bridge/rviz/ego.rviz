Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Plane Cell Count: 40
      Cell Size: 1
      Color: 160; 160; 160
      Alpha: 0.5
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 3
    - Class: rviz/Marker
      Name: EgoMarker
      Enabled: true
      Marker Topic: /ego_marker
      Queue Size: 10
    - Class: rviz/Path
      Name: EgoPath
      Enabled: true
      Topic: /ego_path
      Color: 25; 255; 0
      Line Style: Lines
      Alpha: 1
    - Class: rviz/Path
      Name: GlobalPath
      Enabled: true
      Topic: /global_path
      Color: 0; 170; 255
      Line Style: Lines
      Alpha: 1
    - Class: rviz/Path
      Name: LocalPath
      Enabled: true
      Topic: /local_path
      Color: 255; 170; 0
      Line Style: Lines
      Alpha: 1
    - Class: rviz/MarkerArray
      Name: Objects
      Enabled: true
      Marker Topic: /object_markers
      Queue Size: 100
    - Class: rviz/MarkerArray
      Name: LatticeCandidates
      Enabled: true
      Marker Topic: /lattice_candidates
      Queue Size: 100
    - Class: rviz/Path
      Name: LatticePath
      Enabled: true
      Topic: /lattice_path
      Color: 255; 0; 255
      Line Style: Lines
      Alpha: 1
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Enabled: true
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 30
      Pitch: 0.7
      Yaw: 3.1
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
  Hide Left Dock: false
  Hide Right Dock: false
