# --- catkin 빌드 산출물 ---
catkin_ws/build/
catkin_ws/devel/
catkin_ws/logs/
catkin_ws/.catkin_tools/

# --- 시뮬레이터 바이너리 ---
morai_sim/

# --- 벤더/레퍼런스 (자체 .git 보유, 우리 코드 아님) ---
MORAI-RoboticsExample/
catkin_ws/src/morai_msgs/

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- 에디터/OS ---
.vscode/
*.swp
.DS_Store

# --- SDD 진행 원장(scratch) ---
# .superpowers/ 는 추적 (진행 원장 복구용) — 필요시 조정

# --- 로컬 백업본 (경로 재기록 전 스냅샷 등) ---
*.bak

# --- 대회 제공 맵 데이터 (용량 큼. 필요시 별도 보관) ---
catkin_ws/src/path_tracking/map/*.json

# --- 팀 코드 로컬 사본 (팀 깃허브에서 받는 것. 우리 repo 에 커밋 안 함) ---
#
# 예외 둘: 이 폴더 안에 있지만 planning 이 직접 작성해서 유지하는 파일이다.
#   launch/perception.launch          인지 스택 배선 (2026-08-27 작성)
#   scripts/run_camera_detection_39.sh  YOLO 노드를 별도 파이썬으로 띄우는 래퍼
# 팀 코드 자리에 있다는 이유로 무시하면 우리 repo 어디에도 안 남는다. 그러면
# 팀 코드를 새로 받아 덮는 순간 사라진다(실제로 이 둘만 로컬에 단벌로 있었다).
#
# 디렉터리를 통째로 제외하면 그 안의 파일을 다시 포함시킬 수 없다(git 규칙).
# 그래서 '폴더/*' 로 내용만 제외하고 필요한 것을 ! 로 되살린다.
catkin_ws/src/autonomous_driving/*
!catkin_ws/src/autonomous_driving/launch/
catkin_ws/src/autonomous_driving/launch/*
!catkin_ws/src/autonomous_driving/launch/perception.launch
!catkin_ws/src/autonomous_driving/scripts/
catkin_ws/src/autonomous_driving/scripts/*
!catkin_ws/src/autonomous_driving/scripts/run_camera_detection_39.sh
